{
  "$defs": {
    "CoachingResult": {
      "additionalProperties": false,
      "description": "LLM-generated coaching text, kept separate from deterministic metrics.\n\nWhen ``status`` is ``unavailable`` the narrative fields are empty rather\nthan invented, honoring the never-fabricate rule.",
      "properties": {
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "next_set_cue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Set Cue"
        },
        "observations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observations",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CoachingStatus"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "status"
      ],
      "title": "CoachingResult",
      "type": "object"
    },
    "CoachingStatus": {
      "description": "Whether coaching output is available for a result.",
      "enum": [
        "ok",
        "unavailable"
      ],
      "title": "CoachingStatus",
      "type": "string"
    },
    "CompletionStatus": {
      "description": "Whether a detected repetition was carried to completion.",
      "enum": [
        "completed",
        "partial",
        "uncertain"
      ],
      "title": "CompletionStatus",
      "type": "string"
    },
    "Metric": {
      "additionalProperties": false,
      "description": "One measured quantity for a rep.\n\n``value`` is ``None`` when it could not be measured; ``reason`` then states\nwhy in machine-readable form. ``reference_interval`` is the acceptable\n``(lower, upper)`` band used by scoring.",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "ge": 0,
              "le": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage"
        },
        "deviation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deviation"
        },
        "dimensionality": {
          "title": "Dimensionality",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "quality_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quality Method"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reference_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Interval"
        },
        "rep_id": {
          "title": "Rep Id",
          "type": "string"
        },
        "side": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "id",
        "rep_id",
        "unit",
        "dimensionality",
        "status"
      ],
      "title": "Metric",
      "type": "object"
    },
    "PrototypeAssessment": {
      "additionalProperties": false,
      "properties": {
        "estimated_match": {
          "anyOf": [
            {
              "ge": 0,
              "le": 100,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Match"
        },
        "included_components": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": "Included Components",
          "type": "array"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "omitted_components": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "title": "Omitted Components",
          "type": "array"
        },
        "policy_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "status": {
          "enum": [
            "matched",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PrototypeAssessment",
      "type": "object"
    },
    "Rep": {
      "additionalProperties": false,
      "description": "A single detected repetition with its phase boundaries (seconds).",
      "properties": {
        "completion_status": {
          "$ref": "#/$defs/CompletionStatus"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        },
        "excluded_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Excluded Reasons",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ordinal": {
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "scorable": {
          "title": "Scorable",
          "type": "boolean"
        },
        "side": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "turnaround_end_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnaround End S"
        },
        "turnaround_start_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnaround Start S"
        }
      },
      "required": [
        "id",
        "ordinal",
        "start_s",
        "end_s",
        "completion_status",
        "scorable"
      ],
      "title": "Rep",
      "type": "object"
    },
    "ReportQuality": {
      "additionalProperties": false,
      "properties": {
        "expected_supporting_samples": {
          "minimum": 0,
          "title": "Expected Supporting Samples",
          "type": "integer"
        },
        "missing_reasons": {
          "default": [],
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "per_metric_coverage": {
          "additionalProperties": {
            "ge": 0,
            "le": 1,
            "type": "number"
          },
          "default": {},
          "title": "Per Metric Coverage",
          "type": "object"
        },
        "total_reps": {
          "minimum": 0,
          "title": "Total Reps",
          "type": "integer"
        },
        "usable_reps": {
          "minimum": 0,
          "title": "Usable Reps",
          "type": "integer"
        },
        "valid_observed_samples": {
          "minimum": 0,
          "title": "Valid Observed Samples",
          "type": "integer"
        },
        "view_review": {
          "default": "unreviewed",
          "enum": [
            "reviewed",
            "unreviewed",
            "incompatible"
          ],
          "title": "View Review",
          "type": "string"
        }
      },
      "required": [
        "expected_supporting_samples",
        "valid_observed_samples",
        "usable_reps",
        "total_reps"
      ],
      "title": "ReportQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "0.3 prototype report; standalone, not a subclass of AnalysisResult.",
  "properties": {
    "analysis_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "analysis_scope": {
      "const": "prototype_report",
      "default": "prototype_report",
      "enum": [
        "prototype_report"
      ],
      "title": "Analysis Scope",
      "type": "string"
    },
    "coaching": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoachingResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "detected_rep_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detected Rep Count"
    },
    "detected_rep_count_unavailable_reason": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detected Rep Count Unavailable Reason"
    },
    "exercise": {
      "enum": [
        "lat_pulldown",
        "dumbbell_curl",
        "squat",
        "incline_chest_press"
      ],
      "title": "Exercise",
      "type": "string"
    },
    "metrics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "prototype_assessment": {
      "$ref": "#/$defs/PrototypeAssessment"
    },
    "provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Provenance",
      "type": "object"
    },
    "quality": {
      "$ref": "#/$defs/ReportQuality"
    },
    "recipe_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Recipe Version",
      "type": "string"
    },
    "reps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Rep"
      },
      "title": "Reps",
      "type": "array"
    },
    "schema_version": {
      "const": "0.3.0",
      "default": "0.3.0",
      "enum": [
        "0.3.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "default": null,
      "title": "Score",
      "type": "null"
    },
    "variant": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Variant",
      "type": "string"
    },
    "warnings": {
      "default": [],
      "items": {
        "maxLength": 256,
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "analysis_id",
    "exercise",
    "variant",
    "recipe_version",
    "quality",
    "prototype_assessment"
  ],
  "title": "PrototypeAnalysisResult",
  "type": "object"
}
