          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metric_rules": {
            "additionalProperties": {
              "type": "object"
            },
            "default": {},
            "title": "Metric Rules",
            "type": "object"
          },
          "pose_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pose Key"
          },
          "provider_compatibility": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Provider Compatibility",
            "type": "array"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "source_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "type": {
            "$ref": "#/components/schemas/ReferenceType"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "view": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
