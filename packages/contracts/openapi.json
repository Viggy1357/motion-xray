  "info": {
    "description": "Turns a short workout video into a rep-by-rep movement report.",
    "title": "Motion X Ray API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness probe used by Compose/CI; returns a static ok with no I/O.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/v1/analyses": {
      "post": {
        "description": "Enqueue an analysis job for a video + exercise/variant. FR03. TODO(T08).",
        "operationId": "create_analysis_v1_analyses_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJob"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Analysis"
      }
    },
    "/v1/analyses/{analysis_id}": {
      "delete": {
        "description": "Delete an analysis and its private artifacts. FR03. TODO(T08).",
        "operationId": "delete_analysis_v1_analyses__analysis_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Delete Analysis V1 Analyses  Analysis Id  Delete",
                  "type": "null"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Analysis"
      },
      "get": {
        "description": "Fetch an analysis job's state/stage. FR03, FR12. TODO(T08).",
        "operationId": "get_analysis_v1_analyses__analysis_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Analysis"
      }
    },
    "/v1/analyses/{analysis_id}/artifacts/{kind}": {
      "get": {
        "description": "Fetch a private artifact (e.g. pose frames) for the X Ray UI. FR10. TODO(T11).",
        "operationId": "get_analysis_artifact_v1_analyses__analysis_id__artifacts__kind__get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
