{
  "components": {
    "schemas": {
      "AnalysisJob": {
        "additionalProperties": false,
        "description": "One unit of pipeline work with its state, stage, and lease.\n\n``lease_owner``/``lease_until`` support at-most-one-worker processing;\n``input_hash`` and ``version_hash`` make runs reproducible and cacheable;\n``error`` is populated only on a failed state.",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "cancel_requested": {
            "title": "Cancel Requested",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "input_hash": {
            "title": "Input Hash",
            "type": "string"
          },
          "lease_owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Owner"
          },
          "lease_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Until"
          },
          "owner": {
            "title": "Owner",
            "type": "string"
          },
          "result_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Key"
          },
          "stage": {
            "$ref": "#/components/schemas/JobStage"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version_hash": {
            "title": "Version Hash",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner",
          "state",
          "stage",
          "attempt",
          "cancel_requested",
          "input_hash",
          "version_hash",
          "created_at",
          "updated_at"
        ],
        "title": "AnalysisJob",
        "type": "object"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "description": "The complete rep-by-rep report for one analyzed video.",
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "best_rep_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Best Rep Id"
          },
          "coaching": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoachingResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "exercise": {
            "title": "Exercise",
            "type": "string"
          },
          "metrics": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Metric"
            },
            "title": "Metrics",
            "type": "array"
          },
          "provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Provenance",
            "type": "object"
          },
          "reps": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Rep"
            },
            "title": "Reps",
            "type": "array"
          },
          "schema_version": {
            "const": "0.2.0",
            "default": "0.2.0",
            "enum": [
              "0.2.0"
            ],
            "title": "Schema Version",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "ge": 0,
                "le": 100,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "source_ids": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Variant"
          },
          "warnings": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "worst_rep_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worst Rep Id"
          }
        },
        "required": [
          "analysis_id",
          "exercise"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "CoachingResult": {
        "additionalProperties": false,
        "description": "LLM-generated coaching text, kept separate from deterministic metrics.\n\nWhen ``status`` is ``unavailable`` the narrative fields are empty rather\nthan invented, honoring the never-fabricate rule.",
        "properties": {
          "limitations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "next_set_cue": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Set Cue"
          },
          "observations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Observations",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/CoachingStatus"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          }
        },
        "required": [
          "status"
        ],
        "title": "CoachingResult",
        "type": "object"
      },
      "CoachingStatus": {
        "description": "Whether coaching output is available for a result.",
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "CoachingStatus",
        "type": "string"
      },
      "CompletionStatus": {
        "description": "Whether a detected repetition was carried to completion.",
        "enum": [
          "completed",
          "partial",
          "uncertain"
        ],
        "title": "CompletionStatus",
        "type": "string"
      },
      "EvidenceRefreshRequest": {
        "description": "Body for POST /v1/evidence/refresh \u2014 one exercise technique query.",
        "properties": {
          "allowlist": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowlist"
          },
