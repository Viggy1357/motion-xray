          "technique_question"
        ],
        "title": "EvidenceRefreshRequest",
        "type": "object"
      },
      "EvidenceRefreshResponse": {
        "properties": {
          "drafts": {
            "items": {
              "$ref": "#/components/schemas/SourceRecord"
            },
            "title": "Drafts",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "drafts"
        ],
        "title": "EvidenceRefreshResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobStage": {
        "description": "Pipeline stage an analysis job is currently executing.",
        "enum": [
          "validate",
          "pose",
          "segment",
          "metrics",
          "compare",
          "coach"
        ],
        "title": "JobStage",
        "type": "string"
      },
      "JobState": {
        "description": "Lifecycle state of an analysis job.",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "JobState",
        "type": "string"
      },
      "Metric": {
        "additionalProperties": false,
        "description": "One measured quantity for a rep.\n\n``value`` is ``None`` when it could not be measured; ``reason`` then states\nwhy in machine-readable form. ``reference_interval`` is the acceptable\n``(lower, upper)`` band used by scoring.",
        "properties": {
          "coverage": {
            "anyOf": [
              {
                "ge": 0,
                "le": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage"
          },
          "deviation": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deviation"
          },
          "dimensionality": {
            "title": "Dimensionality",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "quality_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality Method"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "reference_interval": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Interval"
          },
          "rep_id": {
            "title": "Rep Id",
            "type": "string"
          },
          "side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "id",
          "rep_id",
          "unit",
          "dimensionality",
          "status"
        ],
        "title": "Metric",
        "type": "object"
      },
      "ReferenceProfile": {
        "additionalProperties": false,
        "description": "A versioned, approved reference for one exercise/variant/view.",
