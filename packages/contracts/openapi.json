          "excluded_reasons": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Excluded Reasons",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "ordinal": {
            "minimum": 1.0,
            "title": "Ordinal",
            "type": "integer"
          },
          "scorable": {
            "title": "Scorable",
            "type": "boolean"
          },
          "side": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Side"
          },
          "start_s": {
            "title": "Start S",
            "type": "number"
          },
          "turnaround_end_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnaround End S"
          },
          "turnaround_start_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turnaround Start S"
          }
        },
        "required": [
          "id",
          "ordinal",
          "start_s",
          "end_s",
          "completion_status",
          "scorable"
        ],
        "title": "Rep",
        "type": "object"
      },
      "SourceRecord": {
        "additionalProperties": false,
