# Motion X Ray — application-owned runtime configuration.
# Copy to .env and fill secrets. .env is gitignored and MUST NOT be committed.
# The build MUST fail clearly when a selected provider needs an unset credential.
# Never ship a working secret or silently switch to a different model.

APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
SESSION_SECRET=
# Set to a persistent random secret of at least 32 bytes before using /v1/session.

DATABASE_URL=sqlite:////state/motion_xray.db
ARTIFACT_BACKEND=filesystem
ARTIFACT_ROOT=/state/artifacts
VIDEO_ROOT=/state/media

# --- Pose provider ---
# Primary for this build is mediapipe (CPU-friendly, no GPU entitlement needed).
# gem is a documented stretch goal pending GPU access — see DECISIONS.md.
POSE_PROVIDER=mediapipe
POSE_MODEL_REVISION=
POSE_CHECKPOINT_PATH=/models/pose_landmarker.task

# --- Coaching LLM: NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) ---
# This is the required runtime NVIDIA-model call for the hackathon submission.
LLM_PROVIDER=nebius
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Discover the exact model ID from the account catalog; start with the smallest
# supported NVIDIA model and only escalate if measured coaching quality warrants it.
NEBIUS_MODEL_ID=
NEBIUS_API_KEY=

# --- Search / evidence refresh (Tavily) ---
# cached = reviewed local records only (no runtime spend).
# tavily = enables operator-triggered runtime discovery; requires the key.
SEARCH_PROVIDER=cached
TAVILY_API_KEY=

# --- Operational limits (provisional; measure and revise before hosted release) ---
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=30
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SECONDS=300
RAW_MEDIA_TTL_HOURS=24
REPORT_TTL_DAYS=7
