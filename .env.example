# Motion X Ray — application-owned runtime configuration.
# Copy to .env and fill secrets. .env is gitignored and MUST NOT be committed.
# The build MUST fail clearly when a selected provider needs an unset credential.
# Never ship a working secret or silently switch to a different model.

APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:8000
SESSION_SECRET=
# Set to a persistent random secret of at least 32 bytes before using /v1/session.

DATABASE_URL=sqlite:////state/motion_xray.db
ARTIFACT_BACKEND=filesystem
ARTIFACT_ROOT=/state/artifacts
VIDEO_ROOT=/state/media

# --- Pose provider ---
# Primary for this build is mediapipe (CPU-friendly, no GPU entitlement needed).
# gem is a documented stretch goal pending GPU access — see DECISIONS.md.
POSE_PROVIDER=mediapipe
POSE_MODEL_REVISION=
POSE_CHECKPOINT_PATH=/models/pose_landmarker_full.task
POSE_CHECKPOINT_SHA256=5134a3aad27a58b93da0088d431f366da362b44e3ccfbe3462b3827a839011b1

# --- Coaching LLM: NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) ---
# This is the required runtime NVIDIA-model call for the hackathon submission.
# The adapter is now connected to uploaded-set reports; it stays OFF until
# ALLOW_LIVE_COACHING=true and a valid NEBIUS_API_KEY are set.
LLM_PROVIDER=nebius
ALLOW_LIVE_COACHING=false
# Explicit runtime opt-in. Set to true only on a host with a valid NEBIUS_API_KEY.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Exact model ID for the runtime NVIDIA-model call. Override only with a
# known-existing model ID from the Nebius catalog.
NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_API_KEY=

# --- Search / evidence refresh (Tavily) ---
# cached = reviewed local records only (no runtime spend).
# tavily = enables operator-triggered runtime discovery; requires the key.
SEARCH_PROVIDER=cached
TAVILY_API_KEY=

# --- Operational limits (provisional; measure and revise before hosted release) ---
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=60
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=60
WORKER_POLL_SECONDS=1
WORKER_IDLE_SECONDS=1
JOB_TIMEOUT_SECONDS=300
RAW_MEDIA_TTL_HOURS=24
REPORT_TTL_DAYS=7

# Analysis decode resize: 1 enables 720p-equivalent downscale (max short edge 720,
# max long edge 1280, never upscales) for all four supported exercises:
# dumbbell_curl, lat_pulldown, squat, incline_chest_press. Sampling stays 30Hz with
# original source PTS preserved; private full-resolution replay is retained.
# 0 keeps original-resolution decode. Change with empty queue and recreate API+worker together.
POSE_ANALYSIS_RESIZE=1
