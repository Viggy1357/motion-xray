      "width": 100,
      "height": 100,
      "axis": {
        "version": "posture-observation-v1",
        "axis_id": "image_up",
        "up_xy": [0.0, -1.0],
        "positive_cross_sign": 1
      },
      "expected_degrees": 90.0
    },
    {
      "name": "wrap_179_to_minus_179",
      "description": "Circular summary across the +180/-180 boundary should report a 2-degree excursion.",
      "plus_degrees": 179.0,
      "minus_degrees": -179.0,
      "window_start_s": 0.0,
      "window_end_s": 1.0,
      "max_gap_s": 1.0,
      "circular": true,
      "expected_minimum": 179.0,
      "expected_maximum": 181.0,
      "expected_excursion": 2.0,
      "expected_end_change": 2.0
