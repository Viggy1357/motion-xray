# syntax=docker/dockerfile:1.7
# Browser QC image: builds the production Next.js web client and bundles a
# Playwright test runner that exercises the real UI in headless Chromium.
#
# Build context is the repository root. The image is self-contained: it
# installs pnpm 9.12.1 (matching apps/web/package.json#packageManager) and
# npm (for the test workspace). Browsers come from the official
# mcr.microsoft.com/playwright:v1.64.0-noble base so the Chromium binary
# matches @playwright/test 1.64.0 exactly.
#
# Reference: https://playwright.dev/docs/docker
FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f

ENV NEXT_TELEMETRY_DISABLED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PNPM_HOME=/usr/local/share/pnpm \
    PATH=/usr/local/share/pnpm/bin:$PATH \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Toolchain: pnpm 9.12.1 (pinned to match apps/web) installed via npm so
# the binary is portable across architectures (no curl, no apt, no
# OpenSSL legacy provider). npm itself ships with the base image.
RUN npm install -g pnpm@9.12.1 \
 && pnpm --version && node --version && npm --version

WORKDIR /app

# --- App layer -------------------------------------------------------------
# Copy only what pnpm needs to resolve the lockfile, then the rest of the
# web app. The production build runs during image build so the runtime
# command is `pnpm start` (no dev server, no source mounts).
COPY apps/web/package.json apps/web/pnpm-lock.yaml /app/apps/web/
WORKDIR /app/apps/web
RUN pnpm install --frozen-lockfile --prod=false
COPY apps/web/ /app/apps/web/
RUN pnpm build

# --- Test layer ------------------------------------------------------------
# The test workspace is fully isolated from the app workspace. Its
# package-lock.json is generated by the coordinator before the image is
# built (see scripts/check-browser.sh) so this step is reproducible.
WORKDIR /app/tests/browser
COPY tests/browser/package.json tests/browser/package-lock.json /app/tests/browser/
RUN npm ci
COPY tests/browser/ /app/tests/browser/
RUN npm run typecheck

# --- Runtime ---------------------------------------------------------------
# The web server listens on 127.0.0.1:3000 inside the container. The
# Playwright webServer readiness check targets the loopback origin; the
# Playwright config never reaches a real backend because page.route()
# fulfils /api/session and aborts everything else.
WORKDIR /app/tests/browser
RUN mkdir -p /results

ENV APP_WEB_DIR=/app/apps/web \
    TESTS_DIR=/app/tests/browser \
    RESULTS_DIR=/results \
    BASE_URL=http://127.0.0.1:3000

CMD ["npx", "playwright", "test"]
